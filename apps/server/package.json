{
  "name": "@samagama/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API server for the Samagama Internship Portal.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "seed:accounts": "tsx src/scripts/seed-real-accounts.ts",
    "seed:student-accounts": "tsx src/scripts/seed-student-accounts.ts",
    "seed:interactions": "tsx src/scripts/seed-interactions.ts",
    "seed:cleanup": "tsx src/scripts/seed-cleanup.ts",
    "seed:faqs": "tsx src/scripts/seed-faqs.ts",
    "seed:chat-feedback": "tsx src/scripts/seed-chat-feedback.ts",
    "seed:chat-conversations": "tsx src/scripts/seed-extended-chat-conversations.ts",
    "seed:faq-timestamps": "tsx src/scripts/seed-faq-timestamps.ts",
    "seed:faq-votes": "tsx src/scripts/seed-faq-votes.ts",
    "seed:redistribute": "tsx src/scripts/redistribute-activity.ts",
    "reembed:questions": "tsx src/scripts/reembed-community-questions.ts",
    "simulate:student-activity": "tsx src/scripts/simulate-student-activity.ts",
    "simulate:full": "tsx src/scripts/simulate-full.ts",
    "test:search": "tsx src/scripts/test-search-accuracy.ts",
    "test:search:save": "tsx src/scripts/test-search-accuracy.ts > testing-results.md",
    "test:community": "tsx src/scripts/test-community-duplicates.ts",
    "test:community:save": "tsx src/scripts/test-community-duplicates.ts > community-test-results.md",
    "test:combined-filters": "tsx src/scripts/test-combined-filters.ts"
  },
  "dependencies": {
    "@samagama/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
