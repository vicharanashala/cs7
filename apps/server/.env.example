# Server runtime environment.
# Copy this file to `.env` and fill in actual values; never commit `.env` itself.

NODE_ENV=development
PORT=4000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
# Get this from Atlas > Database > Connect > Drivers > Node.js 5.5+
# Database name should be: samagama
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/samagama?retryWrites=true&w=majority

# ─── JWT secrets ──────────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run the command twice — use one value for ACCESS and a different one for REFRESH.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-min-32-chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Add your frontend URL here if deploying remotely.
CORS_ORIGINS=http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── RAG / LLM ────────────────────────────────────────────────────────────────
# mock        = no external calls (default for dev)
# gemini      = Google Gemini API (requires GEMINI_API_KEY)
# ollama      = local Ollama instance — no API key needed
# local-llama = proxy via apps/rag/llm-server (requires LLM_BASE_URL + LLM_INTERNAL_SECRET)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=

# ─── Ollama (LLM_PROVIDER=ollama) ─────────────────────────────────────────────
# No API key required. Ollama always runs on localhost:11434.
# Set OLLAMA_MODEL to whichever model you have pulled (ollama list).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ─── LM Studio / custom LLM server (LLM_PROVIDER=local-llama) ────────────────
# LLM_BASE_URL=http://localhost:5000
# LLM_INTERNAL_SECRET=replace-me
