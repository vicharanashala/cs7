# Root environment file — copy to .env and fill in real values.
# This file is read by apps/server at startup.
# Never commit .env to git.

NODE_ENV=development
PORT=4000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Get from: Atlas → Database → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/samagama?retryWrites=true&w=majority&appName=Cluster0

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run the command twice — use DIFFERENT values for ACCESS and REFRESH.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-chars
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── LLM / RAG ────────────────────────────────────────────────────────────────
# LLM_PROVIDER: mock (default) | gemini | local-llama
# EMBEDDING_PROVIDER: mock (default) | gemini
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=

# ─── RAG LLM Server (shared secret with apps/rag/llm-server) ─────────────────
# Must match INTERNAL_SECRET in apps/rag/llm-server/.env
LLM_INTERNAL_SECRET=replace-with-shared-secret
